{% extends "base.html.j2" %}
{% block content %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 16px 0;">
  <tr><td>
    <h1 style="margin:0; font-size:22px; font-weight:600; color:#164F5B; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
      Nuevo ticket <span style="color:#26272A; font-weight:500;">#{{ ticket.ticket_id }}</span>
    </h1>
  </td></tr>
</table>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #CFD0BF; border-radius:8px;">
  {% macro row(label, value) -%}
  <tr>
    <td style="padding:10px 14px; width:38%; vertical-align:top;">
      <span style="font-size:12px; color:#164F5B; font-weight:600; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">{{ label }}</span>
    </td>
    <td style="padding:10px 14px; vertical-align:top;">
      <span style="font-size:14px; color:#26272A; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">{{ value }}</span>
    </td>
  </tr>
  <tr><td colspan="2" style="border-bottom:1px solid #EAEAEA;"></td></tr>
  {%- endmacro %}

  {{ row('Folio', ticket.ticket_id) }}
  {{ row('Solicitante', (ticket.solicitante_nombre or ticket.solicitante_email)) }}

  {% set desc_trunc = ticket.descripcion[:160] ~ ('...' if ticket.descripcion|length > 160 else '') %}
  {{ row('Descripción', desc_trunc) }}

  {{ row('Prioridad', ticket.priority or 'Por clasificar') }}

  {% if ticket.equipo_nombre or ticket.equipo_alias or ticket.equipo_num_serie or ticket.equipo_id %}
    {{ row('Equipo', ticket.equipo_nombre or ticket.equipo_alias or ticket.equipo_num_serie or ticket.equipo_id) }}
  {% else %}
    {{ row('Equipo', 'Por clasificar') }}
  {% endif %}

  {% if ticket.tipo_servicio_nombre or ticket.tipo_servicio or ticket.tipo_servicio_id %}
    {{ row('Tipo de servicio', ticket.tipo_servicio_nombre or ticket.tipo_servicio or ticket.tipo_servicio_id) }}
  {% else %}
    {{ row('Tipo de servicio', 'Por clasificar') }}
  {% endif %}
</table>

{% if app_base_url %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0 0 0;">
  <tr>
    <td>
      <a href="{{ app_base_url }}/tickets/{{ ticket.ticket_id }}"
         style="display:inline-block; padding:12px 22px; background-color:#208692; color:#FFFFFF; text-decoration:none; font-size:14px; font-weight:600; border-radius:6px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
        Ver ticket en SISGEMEC
      </a>
    </td>
  </tr>
</table>
{% endif %}
{% endblock %}

