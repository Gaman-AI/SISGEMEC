{% extends "base.html.j2" %}
{% block content %}

<!-- Banda superior -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%; margin:0 0 20px 0;">
  <tr>
    <td style="background-color:#208692; border-radius:12px; padding:16px 20px;">
      {% if brand_logo_url %}
        <table role="presentation" cellpadding="0" cellspacing="0">
          <tr>
            <td style="vertical-align:middle; padding-right:10px;">
              <img src="{{ brand_logo_url }}" alt="{{ email_brand or 'AOSENUMA' }}" height="28" style="display:block; border:0; outline:none; text-decoration:none;" />
            </td>
            <td style="vertical-align:middle;">
              <span style="color:#FFFFFF; font-weight:600; font-size:18px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
                {{ email_brand or 'AOSENUMA' }}
              </span>
            </td>
          </tr>
        </table>
      {% else %}
        <span style="color:#FFFFFF; font-weight:600; font-size:18px; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">AOSENUMA</span>
      {% endif %}
    </td>
  </tr>
</table>

<!-- Título + lead -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 8px 0;">
  <tr>
    <td>
      <h1 style="margin:0; font-size:24px; line-height:1.3; color:#164F5B; font-weight:600; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
        Ticket cerrado <span style="color:#26272A; font-weight:500;">#{{ ticket.ticket_id }}</span>
      </h1>
    </td>
  </tr>
</table>
<p style="margin:0 0 16px 0; font-size:14px; line-height:1.6; color:#26272A; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  Hola {{ ticket.solicitante_nombre or ticket.solicitante_email }}, se registró el cierre de tu solicitud.
</p>

<!-- Ficha (tabla limpia con separadores horizontales) -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #EAEAEA; border-radius:10px; padding:0; width:100%;">
  <tr><td colspan="2" style="height:12px;"></td></tr>

  {% macro row(label, value, extra_line) -%}
  <tr>
    <td style="padding:10px 18px; width:38%; vertical-align:top;">
      <span style="font-size:12px; color:#164F5B; font-weight:600; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">{{ label }}</span>
    </td>
    <td style="padding:10px 18px; vertical-align:top;">
      <span style="font-size:14px; color:#26272A; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">{{ value }}</span>
      {% if extra_line %}
      <br /><span style="font-size:12px; color:#164F5B; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">{{ extra_line }}</span>
      {% endif %}
    </td>
  </tr>
  <tr><td colspan="2" style="border-bottom:1px solid #EAEAEA;"></td></tr>
  {%- endmacro %}

  {# Equipo #}
  {% if ticket.equipo_nombre or ticket.equipo_alias or ticket.equipo_num_serie or ticket.equipo_id %}
    {{ row('Equipo', ticket.equipo_nombre or ticket.equipo_alias or ticket.equipo_num_serie or ticket.equipo_id, '') }}
  {% endif %}

  {{ row('Solicitante', (ticket.solicitante_nombre or ticket.solicitante_email), '') }}

  {# Tipo de servicio #}
  {% if ticket.tipo_servicio_nombre or ticket.tipo_servicio or ticket.tipo_servicio_id %}
    {{ row('Tipo de servicio', ticket.tipo_servicio_nombre or ticket.tipo_servicio or ticket.tipo_servicio_id, '') }}
  {% endif %}

  {{ row('Descripción', ticket.descripcion, '') }}

  {% if ticket.trabajo_realizado %}
    {{ row('Trabajo realizado', ticket.trabajo_realizado, '') }}
  {% endif %}

  {% if ticket.observaciones %}
    {{ row('Observaciones', ticket.observaciones, '') }}
  {% endif %}

  {% if ticket.received_at %}
    {{ row('Recibido', ticket.received_at, '') }}
  {% endif %}

  {% if ticket.closed_at %}
    {{ row('Cerrado', ticket.closed_at, '') }}
  {% endif %}

  {% if ticket.fuente %}
    {{ row('Fuente', ticket.fuente, '') }}
  {% endif %}

  <tr><td colspan="2" style="border-bottom:none; height:8px;"></td></tr>
</table>

<!-- CTA -->
{% if app_base_url %}
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0 8px 0;">
    <tr>
      <td align="left">
        <a href="{{ app_base_url }}/tickets/{{ ticket.ticket_id }}"
           style="display:inline-block; padding:14px 28px; background-color:#208692; color:#FFFFFF; text-decoration:none; font-size:15px; font-weight:600; line-height:1; border-radius:6px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
          Solicitar nuevo servicio
        </a>
      </td>
    </tr>
  </table>
{% endif %}

<!-- Nota -->
<p style="margin:8px 0 0 0; font-size:12px; line-height:1.6; color:#26272A; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
  Si necesitas más ayuda, responde a este correo.
</p>

{% endblock %}
